# PL:BR Discord integration - environment variables
# On Railway: service -> Variables (never commit real values to git).

# --- Database (Railway: set to ${{Postgres.DATABASE_URL}}) -------------------
DATABASE_URL=

# --- Roblox game servers -> API -------------------------------------------------
# A long random secret (48+ chars). The SAME value goes into Roblox:
# Creator Dashboard -> your experience -> Secrets, name: PLBR_SYNC_KEY
# Comma-separate two keys while rotating.
ROBLOX_SYNC_KEYS=

# --- Discord (Developer Portal -> your application) ---------------------------
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
KILL_LEADERBOARD_CHANNEL_ID=
WIN_LEADERBOARD_CHANNEL_ID=
LEADERBOARD_INTERVAL_MINUTES=10
ROLE_RECONCILE_MINUTES=30

# --- Bloxlink (blox.link dashboard -> your server -> API / Developer) ----------
BLOXLINK_API_KEY=

# --- Roblox Open Cloud (optional, READ-ONLY key) -------------------------------
# Lets the bot read saved stats for /refresh and backfill leaderboards.
ROBLOX_UNIVERSE_ID=
ROBLOX_OPEN_CLOUD_KEY=
ROBLOX_STATS_DATASTORE=
ROBLOX_STATS_DATASTORE_SCOPE=global
ROBLOX_STATS_ENTRY_KEY={userId}
ROBLOX_STATS_FIELDS=kills=Kills,wins=Wins,deaths=Deaths
ROBLOX_KILLS_ORDERED_DATASTORE=
ROBLOX_WINS_ORDERED_DATASTORE=
ROBLOX_ORDERED_DATASTORE_SCOPE=global

# --- Branding -----------------------------------------------------------------
BRAND_NAME=PL:BR
BRAND_COLOR=EE4826
GAME_URL=

# Welcome DM for new members. Turn on "Server Members Intent" (Developer Portal -> Bot) FIRST,
# otherwise the bot can't log in with this set.
WELCOME_DMS=false
# Optional: DM this Discord user ID the welcome message once at startup (preview)
WELCOME_TEST_USER_ID=
